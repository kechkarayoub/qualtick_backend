# Backend Environment Variables - Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_CONTAINER_EXTERNAL_PORT=5434
DB_CONTAINER_INTERNAL_PORT=5432
DB_IP=postgres
DB_NAME=your_database_name
DB_ROOT_PASSWORD=your_root_password
DB_USER_NM=your_db_username
DB_USER_PW=your_db_password

# Django Configuration
DJANGO_CONTAINER_EXTERNAL_PORT=8080
DJANGO_CONTAINER_INTERNAL_PORT=8000
DJANGO_SECRET_KEY=your-very-secret-django-key
PIPLINE=development

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-app-email@gmail.com

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PHONE_NUMBER_VERIFICATION=false

# Firebase Push Notifications
ENABLE_PUSH_NOTIFICATIONS=true
FCM_MAX_WORKERS=10
FCM_TOKEN_CLEANUP_DAYS=30
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_VAPID_KEY=your-vapid-key-from-firebase-console

# Redis Configuration
REDIS_CONTAINER_EXTERNAL_PORT=6379
REDIS_CONTAINER_INTERNAL_PORT=6379
REDIS_URL=redis://redis:6379

# WebSocket Configuration
WS_EXTERNAL_PORT=9000
WS_INTERNAL_PORT=9000

# WhatsApp Integration (Optional)
WHATSAPP_INSTANCE_ID=your-instance-id
WHATSAPP_INSTANCE_TOKEN=your-instance-token
WHATSAPP_INSTANCE_URL=your-whatsapp-api-url
