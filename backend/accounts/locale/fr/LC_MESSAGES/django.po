#: views/sign_in_views.py:57
msgid "Email/Username and password are required"
msgstr "L'e-mail/nom d'utilisateur et le mot de passe sont requis"

#: views/sign_in_views.py:72 views/sign_in_views.py:201
msgid ""
"Your account is deleted. Please contact the technical team to resolve your "
"issue."
msgstr ""
"Votre compte est supprimé. Veuillez contacter l'équipe technique pour "
"résoudre votre problème."

#: views/sign_in_views.py:81 views/sign_in_views.py:210
msgid ""
"Your account is inactive. Please contact the technical team to resolve your "
"issue."
msgstr ""
"Votre compte est inactif. Veuillez contacter l'équipe technique pour "
"résoudre votre problème."

#: views/sign_in_views.py:93
msgid ""
"Your email is not yet verified. Please verify your email address before sign "
"in."
msgstr ""
"Votre e-mail n'est pas encore vérifié. Veuillez vérifier votre adresse "
"e-mail avant de vous connecter."

#: views/sign_in_views.py:115 views/sign_in_views.py:117
#: views/sign_in_views.py:230
msgid "Invalid credentials"
msgstr "Identifiants invalides"

#: views/sign_in_views.py:150 views/sign_up_views.py:124
msgid "Email, Id token and Third party type are required"
msgstr "L'e-mail, le jeton d'identité et le type de tiers sont requis"

#: views/sign_up_views.py:75
msgid ""
"Your account is created successfully. Log in with your username and password."
msgstr ""
"Votre compte a été créé avec succès. Connectez-vous avec votre nom "
"d'utilisateur et votre mot de passe."

#: views/sign_up_views.py:81
msgid ""
"Your account has been successfully created. You can log in once you validate "
"your email via the link sent to your email address."
msgstr ""
"Votre compte a été créé avec succès. Vous pouvez vous connecter une fois "
"votre e-mail validé via le lien envoyé à votre adresse e-mail."

#: views/sign_up_views.py:90
msgid ""
"We cannot create your account due to the following errors. Please correct "
"them and try again."
msgstr ""
"Nous ne pouvons pas créer votre compte en raison des erreurs suivantes. "
"Veuillez les corriger et réessayer."

#: views/sign_up_views.py:162
msgid ""
"Unable to verify your account with the provided third-party credentials. "
"Please check your information or try a different sign-up method."
msgstr ""
"Impossible de vérifier votre compte avec les informations d'identification "
"tierces fournies. Veuillez vérifier vos informations ou essayer une autre "
"méthode d'inscription."

#: views/sign_up_views.py:201
msgid ""
"Unable to create or authenticate your account with the provided third-party "
"credentials. Please check your information or try a different sign-up method."
msgstr ""
"Impossible de créer ou d'authentifier votre compte avec les informations "
"d'identification tierces fournies. Veuillez vérifier vos informations ou "
"essayer une autre méthode d'inscription."
