msgstr "Un nouveau code de vérification sera envoyé à votre numéro de téléphone."

#: views/phone_number_views.py:80
msgid "Expired verification code."
msgstr "Code de vérification expiré."

#: views/phone_number_views.py:84
#, python-brace-format
msgid ""
"Your sms verification code quota has been exceeded. Please contact the "
"technical service at {technical_service_email} to resolve your problem."
msgstr ""
"Votre quota de codes de vérification par SMS a été dépassé. Veuillez "
"contacter le service technique à {technical_service_email} pour résoudre "
"votre problème."

#: views/phone_number_views.py:89
