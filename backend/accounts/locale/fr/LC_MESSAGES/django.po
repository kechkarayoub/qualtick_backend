msgid "Invalid or expired reset token. Please request a new password reset."
msgstr "Jeton de réinitialisation invalide ou expiré. Veuillez en demander un nouveau."

#: views/password_views.py:138
msgid ""
"Password has been reset successfully. You can now log in with your new "
"password."
msgstr ""
"Le mot de passe a été réinitialisé avec succès. Vous pouvez maintenant vous "
"connecter avec votre nouveau mot de passe."

#: views/password_views.py:146
msgid "An error occurred while resetting your password. Please try again."
msgstr "Une erreur s'est produite lors de la réinitialisation. Veuillez réessayer."

