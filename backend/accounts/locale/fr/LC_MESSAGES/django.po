#: views/password_views.py:51
msgid "Email or username is required"
msgstr "L'e-mail ou le nom d'utilisateur est requis"

#: views/password_views.py:56
msgid ""
"If an account with this email or username exists, you will receive a "
"password reset link shortly."
msgstr ""
"Si un compte avec cet e-mail ou ce nom d'utilisateur existe, vous recevrez "
"un lien de réinitialisation du mot de passe sous peu."

